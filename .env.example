# ── LLM Provider ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Arize Phoenix Tracing ──────────────────────────────────────
# Local Phoenix (default): leave PHOENIX_COLLECTOR_ENDPOINT as-is
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT=multi-step-agent

# Cloud Arize AX (optional — leave blank for local mode):
# ARIZE_SPACE_ID=your_space_id
# ARIZE_API_KEY=your_arize_api_key

# ── Production Hardening & Security ───────────────────────────
# API Authentication (Leave blank for open local dev, or set a secure token):
AGENT_API_KEY=your_secure_agent_api_key_here

# CORS Allowed Origins (comma-separated):
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000

# Session TTL Management (prevents memory leak DoS):
MAX_SESSIONS=10000
SESSION_TTL_SECONDS=86400

# ── Agent Config ───────────────────────────────────────────────
MAX_REACT_STEPS=10
EVAL_K_TRIALS=3
EVAL_N_TASKS=20
